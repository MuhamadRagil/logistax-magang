# ─────────────────────────────────────────────────────────────────────────
# Referensi variable untuk Railway (service logistax-magang).
# Isi lewat Railway → Service → Variables. JANGAN commit nilai asli.
# Baris bertanda [WAJIB] harus diisi; sisanya boleh dibiarkan default.
# ─────────────────────────────────────────────────────────────────────────

# ── Aplikasi ──────────────────────────────────────────────────────────────
APP_NAME="Logistax Magang"
APP_ENV=production                                    # [WAJIB]
APP_DEBUG=false                                       # [WAJIB] jangan true di production
# [WAJIB] generate lokal: php artisan key:generate --show  → tempel hasilnya
APP_KEY=base64:GANTI_DENGAN_HASIL_KEY_GENERATE
# [WAJIB] domain publik Railway, HTTPS, tanpa slash di akhir. Dipakai untuk
# URL file bukti izin/sakit & sertifikat (Storage::url) — salah isi = link rusak.
APP_URL=https://logistax-magang-production.up.railway.app
APP_TIMEZONE=Asia/Jakarta                             # [WAJIB]
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr                                    # log tampil di Railway Deploy Logs
LOG_LEVEL=info

# ── Database (MySQL plugin Railway) ───────────────────────────────────────
# Pakai "Reference Variable" Railway agar otomatis ikut plugin MySQL:
DB_CONNECTION=mysql                                   # [WAJIB]
DB_HOST=${{MySQL.MYSQLHOST}}                          # [WAJIB]
DB_PORT=${{MySQL.MYSQLPORT}}                          # [WAJIB]
DB_DATABASE=${{MySQL.MYSQLDATABASE}}                  # [WAJIB]
DB_USERNAME=${{MySQL.MYSQLUSER}}                      # [WAJIB]
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}                  # [WAJIB]

# ── Session / cache / queue ───────────────────────────────────────────────
SESSION_DRIVER=database                               # file hilang tiap redeploy → admin ter-logout
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync                                 # tidak butuh worker terpisah
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── Mail (kalau belum dipakai, biarkan log) ───────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@logistax.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── Browsershot / PDF sertifikat ──────────────────────────────────────────
# Kosongkan semua: start command di railway.json mengisi otomatis dari
# Chromium/Node hasil Nix (command -v). Isi manual hanya untuk override,
# dengan path ABSOLUT Linux (bukan path Windows lokal).
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
BROWSERSHOT_CHROME_PATH=
PUPPETEER_EXECUTABLE_PATH=
